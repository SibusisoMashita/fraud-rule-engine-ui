worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 512;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    access_log off;
    client_body_temp_path /tmp/client-body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;

    upstream engine_api {
        zone engine_api 64k;
        resolver 127.0.0.11 valid=5s ipv6=off;
        server ${API_UPSTREAM} resolve;
    }

    server {
        listen 8080;
        root /usr/share/nginx/html;
        client_max_body_size 64k;
        client_header_timeout 10s;
        client_body_timeout 10s;
        send_timeout 10s;
        keepalive_timeout 15s;

        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Frame-Options DENY always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

        location = /health/live {
            default_type application/json;
            return 200 '{"status":"UP"}';
        }

        location = /api/v1/evaluations {
            include /etc/nginx/api-proxy.conf;
        }
        location = /api/v1/rules {
            include /etc/nginx/api-proxy.conf;
        }
        location = /api/v1/transactions {
            include /etc/nginx/api-proxy.conf;
        }
        location ~ "^/api/v1/transactions/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" {
            include /etc/nginx/api-proxy.conf;
        }
        location = /api/v1/admin/policy {
            include /etc/nginx/api-proxy.conf;
        }
        location = /api/v1/admin/policy/validate {
            include /etc/nginx/api-proxy.conf;
        }
        location = /api {
            return 404;
        }
        location /api/ {
            return 404;
        }
        location /health/ {
            return 404;
        }
        location /assets/ {
            expires 1y;
            try_files $uri =404;
        }
        location / {
            expires -1;
            try_files $uri $uri/ /index.html;
        }
    }
}
